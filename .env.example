# 飞书自建应用凭证
# 获取：open.feishu.cn → 开发者后台 → 你的应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ---- 大模型 provider 密钥（per-provider，对应 config.yaml 的 providers 段）----
# free-tokens 免费多模型网关（默认主力）：https://free-tokens.msh.team
FREE_TOKENS_API_KEY=
# Kimi Code 订阅端点（当前无有效 key，config.yaml 里默认 disabled）
KIMI_CODING_API_KEY=
# Moonshot 官方按量付费（platform.moonshot.cn → API Key 管理，默认 disabled）
MOONSHOT_API_KEY=

# 兼容：旧变量 KIMI_API_KEY 仍可用，效果等同于 MOONSHOT_API_KEY（建议改名）
# KIMI_API_KEY=
# 本地文件生命周期（可选；不填使用括号内默认值）
# 论文 PDF + 解析缓存保留小时数（168），便于短期复读免重复解析
PAPER_CACHE_TTL_HOURS=168
# 论文缓存总容量 MB（2048）与最多对象数（20），超限按最近最少使用淘汰
PAPER_CACHE_MAX_MB=2048
PAPER_CACHE_MAX_ENTRIES=20
# 单个 PDF 最大 MB（250）；磁盘至少保留 MB（512），低于水位拒绝新下载但不杀活跃任务
PAPER_CACHE_MAX_ITEM_MB=250
STORAGE_MIN_FREE_MB=512
# 崩溃遗留的未完成下载保留小时数（24）
INCOMPLETE_FILE_TTL_HOURS=24
# 简历、定制稿、录音崩溃遗留的最长分钟数（60；正常任务结束立即删除）
SENSITIVE_FILE_TTL_MINUTES=60
